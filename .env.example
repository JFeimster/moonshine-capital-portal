# Moonshine Capital Portal Environment Variables

# Notion Persistence (Required)
NOTION_API_KEY=your_notion_api_key_here
NOTION_BROKER_DATABASE_ID=your_broker_database_id_here
NOTION_FUNDING_LEADS_DB_ID=your_funding_leads_database_id_here

# Temporary Internal Access Gate
AUTH_SESSION_SECRET=your_32_char_random_secret_here
ADMIN_ACCESS_PASSWORD=admin_secret_password
# PORTAL_ACCESS_PASSWORD=optional_portal_password

# Tally
TALLY_APPLICATION_FORM_ID=rjM6do
TALLY_PROFILE_FORM_ID=9qjWEE
# Preferred raw Tally webhook HMAC secret for POST /api/webhooks/tally.
TALLY_SIGNING_SECRET=your_tally_signing_secret
# Compatibility secret for trusted pre-normalized intake routes.
# During migration, the raw webhook verifier also accepts this as a signing-secret fallback.
TALLY_WEBHOOK_SECRET=your_trusted_intake_secret

# Optional downstream automation/orchestration
# n8n is not required for Tally normalization or canonical persistence.
# N8N_CTA_WEBHOOK_URL=https://n8n.example.com/webhook/cta
# N8N_INTAKE_WEBHOOK_URL=https://n8n.example.com/webhook/intake

# Optional Wix Compatibility
# WIX_API_KEY=your_wix_key
# WIX_SITE_ID=your_wix_site_id
