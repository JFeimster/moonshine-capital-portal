# Moonshine Capital Portal Environment Variables

# Notion CRM Persistence (Required)
NOTION_API_KEY=your_notion_api_key_here
NOTION_BROKER_DATABASE_ID=your_database_id_here

# Temporary Internal Access Gate
AUTH_SESSION_SECRET=your_32_char_random_secret_here
ADMIN_ACCESS_PASSWORD=admin_secret_password
# PORTAL_ACCESS_PASSWORD=optional_portal_password

# Webhook Endpoints
N8N_CTA_WEBHOOK_URL=https://n8n.example.com/webhook/cta
N8N_INTAKE_WEBHOOK_URL=https://n8n.example.com/webhook/intake

# Application Identifiers
TALLY_APPLICATION_FORM_ID=your_tally_form_id
TALLY_PROFILE_FORM_ID=your_tally_form_id
TALLY_WEBHOOK_SECRET=your_tally_secret

# Optional Wix Compatibility
# WIX_API_KEY=your_wix_key
# WIX_SITE_ID=your_wix_site_id
