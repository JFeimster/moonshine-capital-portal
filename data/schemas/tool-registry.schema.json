{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital.distilledfunding.com/schemas/tool-registry.schema.json",
  "title": "Moonshine Capital Tool Registry",
  "type": "object",
  "required": ["tools"],
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "brokerAssignment": {
      "type": "object",
      "required": ["brokerSlug", "featured"],
      "additionalProperties": false,
      "properties": {
        "brokerSlug": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean" }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "id", "slug", "title", "description", "kind", "category", "resourceType",
        "renderType", "accessLevel", "status", "url", "ctaLabel", "ctaHref",
        "tags", "audience", "verticals", "useCases", "brokerAssignments", "featured", "sortOrder"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "slug": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["tool", "resource"] },
        "category": { "type": "string", "minLength": 1 },
        "resourceType": { "type": "string", "minLength": 1 },
        "renderType": { "enum": ["iframe", "internal", "external"] },
        "accessLevel": { "enum": ["public", "portal", "admin"] },
        "status": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "embedUrl": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "ctaLabel": { "type": "string", "minLength": 1 },
        "ctaHref": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "audience": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verticals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "useCases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "brokerAssignments": { "type": "array", "items": { "$ref": "#/$defs/brokerAssignment" } },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
